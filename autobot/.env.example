PUBLIC_ORIGIN=https://autobot.example.com
APP_TIMEZONE=Asia/Ho_Chi_Minh
ADMIN_PASSWORD=
DISCORD_USER_TOKEN=
MATRIX_URL=http://synapse:8008
MATRIX_DOMAIN=matrix.autobot.internal
MATRIX_ACCESS_TOKEN=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_ALLOWED_ORIGINS=
# Mức thinking khi tóm tắt (để trống nếu nhà cung cấp không hỗ trợ reasoning_effort), ví dụ: high, xhigh, max
OPENAI_REASONING_EFFORT=
# Model tư vấn cho câu hỏi phức tạp và /tuvan; tự chọn bản *-sol mới nhất trong /models nếu có
OPENAI_ADVISOR_MODEL=gpt-6.2-sol
OPENAI_ADVISOR_EFFORT=
MAUTRIX_IMAGE=dock.mau.dev/mautrix/meta:v26.11
SYNAPSE_IMAGE=matrixdotorg/synapse:v1.141.0
# Optional: official Facebook Page chat, separate from mautrix-meta.
FB_APP_SECRET=
FB_VERIFY_TOKEN=
FB_PAGE_ACCESS_TOKEN=
FB_PAGE_ID=
MY_FB_PSID=
